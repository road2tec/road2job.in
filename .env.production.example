APP_NAME="Road2Job"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://road2job.in
APP_KEY=

# Hostinger hPanel > Databases > MySQL Databases
# Fill these in from hPanel at deploy time - do not commit real values.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u448940947_Road2job_db
DB_USERNAME=u448940947_Road2job
DB_PASSWORD=

MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@road2job.in
MAIL_FROM_NAME="Road2Job"

FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=FSTSMS
FAST2SMS_ROUTE=otp
FAST2SMS_COUNTRY_CODE=91

OTP_CHANNEL=sms
FAST2SMS_WABA_API_VERSION=v24.0
FAST2SMS_WABA_PHONE_NUMBER_ID=
FAST2SMS_WABA_TEMPLATE_NAME=
FAST2SMS_WABA_TEMPLATE_LANGUAGE=en

SESSION_LIFETIME=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

REMEMBER_ME_DAYS=30
EMAIL_VERIFICATION_EXPIRY_MINUTES=60

# Deliberately false for this launch, "as of now" - Fast2SMS can't actually
# deliver OTPs yet (no DLT registration, no approved WhatsApp template), so
# requiring OTP would silently block every real registration. A known,
# chosen, temporary trade-off, not an oversight - flip to true once Fast2SMS
# delivery is confirmed working end-to-end.
REQUIRE_OTP=false
