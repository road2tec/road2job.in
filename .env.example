APP_NAME="Road2Job"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Road2job/public
APP_KEY=

DB_HOST=127.0.0.1
# 3307, not the MySQL default 3306 - this machine has an unrelated system
# MySQL80 Windows service already bound to 3306, so XAMPP's mysqld (see
# d:\xampp\mysql\bin\my.ini) was moved to 3307 to avoid the conflict.
DB_PORT=3307
DB_DATABASE=road2job
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@road2job.in
MAIL_FROM_NAME="Road2Job"

FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=FSTSMS
FAST2SMS_ROUTE=otp
FAST2SMS_COUNTRY_CODE=91

# OTP delivery channel: sms (needs DLT registration on Fast2SMS) or whatsapp
# (needs a Meta-approved AUTHENTICATION template on a connected WABA number).
OTP_CHANNEL=sms
FAST2SMS_WABA_API_VERSION=v24.0
FAST2SMS_WABA_PHONE_NUMBER_ID=
FAST2SMS_WABA_TEMPLATE_NAME=
FAST2SMS_WABA_TEMPLATE_LANGUAGE=en

SESSION_LIFETIME=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

REMEMBER_ME_DAYS=30
EMAIL_VERIFICATION_EXPIRY_MINUTES=60

# Must stay true for any real deployment. Only set to false for local
# demo/testing convenience - skips OTP/email verification entirely.
REQUIRE_OTP=true
